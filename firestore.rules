rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email']) &&
               data.uid is string && data.uid.size() <= 128 &&
               data.email is string && data.email.size() <= 256;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && isEmailVerified();
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().email == existing().email &&
                    incoming().uid == existing().uid &&
                    isEmailVerified();
    }

    // Curriculums
    match /users/{userId}/curriculums/{curriculumId} {
      function isValidCurriculum(data) {
        return data.keys().hasAll(['userId', 'subject', 'level', 'chapters']) &&
               data.userId == userId &&
               data.subject is string && data.subject.size() <= 200 &&
               data.level is string && data.level.size() <= 100 &&
               data.chapters is list && data.chapters.size() <= 50;
      }

      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidCurriculum(incoming()) && isEmailVerified();
      allow update: if isOwner(userId) && isValidCurriculum(incoming()) && 
                    incoming().userId == existing().userId &&
                    isEmailVerified();
      allow delete: if isOwner(userId);
    }

    // Chapter Details
    match /users/{userId}/curriculums/{curriculumId}/details/{chapterTitle} {
      function isValidDetails(data) {
        return data.keys().hasAny(['content', 'youtubeLinks', 'quiz']) &&
               (data.get('content', '') is string && data.get('content', '').size() <= 100000);
      }

      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidDetails(incoming()) && isEmailVerified();
      allow delete: if isOwner(userId);
    }
  }
}
