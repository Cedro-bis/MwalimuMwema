rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAccountVerified(userId) {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(userId)).data.get('isVerified', false) == true;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // Temporary Verification Codes
    match /users/{userId}/private/verification {
      allow get, write: if isOwner(userId);
    }

    // Curriculums
    match /users/{userId}/curriculums/{curriculumId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isAccountVerified(userId);
      allow update: if isOwner(userId) && isAccountVerified(userId);
      allow delete: if isOwner(userId);
    }

    // Chapter Details
    match /users/{userId}/curriculums/{curriculumId}/details/{chapterTitle} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isAccountVerified(userId);
      allow delete: if isOwner(userId);
    }
  }
}
