{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Curriculum": {
      "title": "Curriculum",
      "description": "A generated curriculum containing multiple chapters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "level": { "type": "string" },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" },
              "isCompleted": { "type": "boolean" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subject", "level", "chapters"]
    },
    "ChapterDetails": {
      "title": "ChapterDetails",
      "description": "Detailed content and resources for a specific chapter",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "youtubeLinks": {
          "type": "array",
          "items": { "type": "object" }
        },
        "quiz": {
          "type": "array",
          "items": { "type": "object" }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public (limited) or private user data"
    },
    "/users/{userId}/curriculums/{curriculumId}": {
      "schema": "Curriculum",
      "description": "Curriculums generated by the user"
    },
    "/users/{userId}/curriculums/{curriculumId}/details/{chapterTitle}": {
      "schema": "ChapterDetails",
      "description": "Detailed lecture content and quiz for a chapter"
    }
  }
}
